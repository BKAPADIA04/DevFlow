# Neo4j (docker-compose.yml exposes bolt on this port)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Comma-separated Gemini API keys, round-robined for rate-limit failover
# (helper/gemini_key_pool.py). Note: the free tier's daily request quota
# is per Google Cloud project, not per key — multiple keys from the same
# project share one quota.
GEMINI_API_KEYS=

# Optional: LangSmith tracing for every LLM call in extraction/ and retrieval/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=devflow
